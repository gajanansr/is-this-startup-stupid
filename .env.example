# OpenRouter key — get one at https://openrouter.ai/keys
# Put the REAL key in .env (which is gitignored), never in this file.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Optional: pin a Jev version. Defaults to typesafe/jev-1.13
# JEV_MODEL=typesafe/jev-1.13

# Optional: your deployed URL, sent to OpenRouter as HTTP-Referer
# PUBLIC_URL=https://isthisstartupstupid.com
